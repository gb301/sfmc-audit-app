PORT=3000
NODE_ENV=development

# Public URL of this app — used in alert email CTA button links
# Local: http://localhost:3001  |  Production: https://your-app.herokuapp.com
APP_URL=http://localhost:3001

# Anthropic Claude API — required for AI executive summaries on the Summary tab
ANTHROPIC_API_KEY=sk-ant-...

# Session secret (generate with: openssl rand -hex 32)
SESSION_SECRET=your-secret-here

# SQLite DB path (Heroku ephemeral — replace with Postgres for production)
DB_PATH=./audit.db

# ---------------------------------------------------------------------------
# SFMC Alert Email (optional — required only to receive nightly alert emails)
# ---------------------------------------------------------------------------
# Installed package credentials for the Business Unit that owns the alert
# email asset and transactional send definition.
# Required scopes: Email (Read+Write), Messaging (Read+Write),
#                  Assets – Documents and Images (Read+Write),
#                  Assets – Saved Content (Read+Write)
# See README for full setup instructions.
SFMC_ALERT_CLIENT_ID=
SFMC_ALERT_CLIENT_SECRET=
SFMC_ALERT_SUBDOMAIN=
SFMC_ALERT_ACCOUNT_ID=

# Content Builder asset ID and send definition key for the alert email.
# Update these after creating your own CB asset and transactional send def.
SFMC_ALERT_CB_ASSET_ID=
SFMC_ALERT_SEND_DEF_KEY=
