{
  "name": "sfmc-audit-app",
  "version": "1.0.0",
  "description": "Salesforce Marketing Cloud Account Audit Application",
  "scripts": {
    "start": "node server/src/index.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon server/src/index.js",
    "dev:client": "cd client && npm start",
    "build": "cd client && npm run build",
    "postinstall": "cd client && npm install"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "axios": "^1.6.2",
    "xml2js": "^0.6.2",
    "node-cache": "^5.1.2",
    "@anthropic-ai/sdk": "^0.24.3",
    "uuid": "^9.0.0",
    "better-sqlite3": "^9.4.3",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  }
}
